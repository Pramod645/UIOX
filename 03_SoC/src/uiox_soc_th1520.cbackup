/*
 * 02_FwHal/src/uiox_soc_th1520.c
 * UIOX SoC abstraction — T-Head TH1520 (RISC-V 64) backend.
 *
 * The TH1520 is a quad-core XuanTie C910 (RV64IMAFDC) SoC:
 *   - PLIC at 0xE0000000
 *   - CLINT at 0xE4000000
 *   - UART0 (16550-compatible) at 0xFFEC0000
 *   - Clock/Reset controller at 0xFFEF010000
 *   - PCIe at 0xFFE7040000
 *   - USB3 at 0xFFE7040000
 *   - eMMC at 0xFFE7080000
 *
 * Ref: T-Head TH1520 SoC Datasheet and Lichee Pi 4A BSP
 */

#include "../include/uiox_soc.h"
#include "../../10_Arch/riscv64/include/arch_defs.h"
#include "../../20_DriverInterfaces/include/hw_types.h"
#include "../../20_DriverInterfaces/include/mmio.h"
#include "../../20_DriverInterfaces/include/irq.h"
#include <stdio.h>
#include <string.h>

/* =========================================================================
 * TH1520 MMIO addresses
 * ====================================================================== */

/* PLIC */
#define TH1520_PLIC_BASE        0xE0000000UL
#define TH1520_PLIC_SIZE        0x04000000UL
#define TH1520_PLIC_PRIORITY(n) (TH1520_PLIC_BASE + 4u*(n))
#define TH1520_PLIC_ENABLE(ctx) (TH1520_PLIC_BASE + 0x2000u + (ctx)*0x80u)
#define TH1520_PLIC_THRESHOLD(c)(TH1520_PLIC_BASE + 0x200000u + (c)*0x1000u)
#define TH1520_PLIC_CLAIM(ctx)  (TH1520_PLIC_BASE + 0x200004u + (ctx)*0x1000u)

/* CLINT */
#define TH1520_CLINT_BASE       0xE4000000UL
#define TH1520_CLINT_MSIP(h)    (TH1520_CLINT_BASE + (h)*4u)
#define TH1520_CLINT_MTIMECMP(h)(TH1520_CLINT_BASE + 0x4000u + (h)*8u)
#define TH1520_CLINT_MTIME      (TH1520_CLINT_BASE + 0xBFF8u)

/* UART0 (16550) */
#define TH1520_UART0_BASE       0xFFEC0000UL
#define TH1520_UART0_IRQ        36u

/* Clock controller */
#define TH1520_CLK_BASE         0xFFEF010000ULL
#define TH1520_CLK_UART0_EN    (TH1520_CLK_BASE + 0x1Cu)

/* =========================================================================
 * CSR helpers
 * ====================================================================== */
#define rv64_csrr(reg)   ({ uint64_t _v; \
    __asm__ volatile("csrr %0, " #reg : "=r"(_v)); _v; })
#define rv64_csrw(reg,v) \
    __asm__ volatile("csrw " #reg ", %0" :: "r"((uint64_t)(v)) : "memory")

/* =========================================================================
 * CLINT init
 * ====================================================================== */
static void th1520_clint_init(uint32_t hart_id)
{
    mmio_write32(TH1520_CLINT_MSIP(hart_id), 0u);
    mmio_write32(TH1520_CLINT_MTIMECMP(hart_id),      0xFFFFFFFFu);
    mmio_write32(TH1520_CLINT_MTIMECMP(hart_id) + 4u, 0xFFFFFFFFu);
    printf("[soc/th1520] CLINT @ 0x%08lx  hart=%u  MTIMECMP cleared\n",
           (unsigned long)TH1520_CLINT_BASE, hart_id);
}

/* =========================================================================
 * PLIC init — enable UART0 IRQ for hart 0 S-mode
 * ====================================================================== */
static void th1520_plic_init(void)
{
    mmio_write32(TH1520_PLIC_PRIORITY(TH1520_UART0_IRQ), 1u);

    uint32_t ctx  = 1u;   /* hart0 S-mode */
    uint32_t word = TH1520_UART0_IRQ / 32u;
    uint32_t bit  = TH1520_UART0_IRQ % 32u;
    uint32_t en   = mmio_read32(TH1520_PLIC_ENABLE(ctx) + word * 4u);
    mmio_write32(TH1520_PLIC_ENABLE(ctx) + word * 4u, en | (1u << bit));
    mmio_write32(TH1520_PLIC_THRESHOLD(ctx), 0u);

    printf("[soc/th1520] PLIC @ 0x%08lx  UART0_IRQ=%u enabled\n",
           (unsigned long)TH1520_PLIC_BASE, TH1520_UART0_IRQ);
}

/* =========================================================================
 * UART0 init — 16550-compatible, 115200 8N1
 * TH1520 UART ref clock = 100 MHz → divisor = 100000000/(16×115200) ≈ 54
 * ====================================================================== */
static void th1520_uart_init(void)
{
    mmio_write32(TH1520_UART0_BASE + 0x04u, 0x00u);  /* IER: off          */
    mmio_write32(TH1520_UART0_BASE + 0x0Cu, 0x80u);  /* LCR: DLAB on      */
    mmio_write32(TH1520_UART0_BASE + 0x00u, 0x36u);  /* DLL: 54           */
    mmio_write32(TH1520_UART0_BASE + 0x04u, 0x00u);  /* DLH: 0            */
    mmio_write32(TH1520_UART0_BASE + 0x0Cu, 0x03u);  /* LCR: 8N1, DLAB off*/
    mmio_write32(TH1520_UART0_BASE + 0x08u, 0xC7u);  /* FCR: FIFO enable  */
    mmio_write32(TH1520_UART0_BASE + 0x04u, 0x01u);  /* IER: RX int       */
    printf("[soc/th1520] UART0 @ 0x%08lx  115200 8N1\n",
           (unsigned long)TH1520_UART0_BASE);
}

/* =========================================================================
 * uiox_soc_init_th1520
 * ====================================================================== */
int uiox_soc_init_th1520(uiox_soc_desc_t *desc)
{
    if (!desc) return UIOX_SOC_ERR_INVAL;

    printf("[soc/th1520] Initialising T-Head TH1520 SoC layer...\n");

    strncpy(desc->name, "T-Head TH1520 (XuanTie C910 RV64×4)",
            UIOX_SOC_NAME_LEN - 1);
    desc->soc_id       = UIOX_SOC_TH1520;
    desc->num_cpus     = 4u;
    desc->num_clusters = 1u;
    desc->cpu_freq_khz = 1850000u;   /* 1.85 GHz typical */
    desc->l1_icache_kb = 64u;
    desc->l1_dcache_kb = 64u;
    desc->l2_cache_kb  = 256u;       /* per-core */
    desc->l3_cache_kb  = 1024u;      /* 1 MB shared */
    desc->dram_base    = 0x00000000UL;
    desc->dram_size    = 0x200000000ULL;  /* up to 16 GB LPDDR4X */
    desc->capabilities = UIOX_SOC_CAP_MMU      | UIOX_SOC_CAP_CACHE_L1
                       | UIOX_SOC_CAP_CACHE_L2 | UIOX_SOC_CAP_CACHE_L3
                       | UIOX_SOC_CAP_SMP      | UIOX_SOC_CAP_PLIC
                       | UIOX_SOC_CAP_TRNG     | UIOX_SOC_CAP_PCIE
                       | UIOX_SOC_CAP_USB      | UIOX_SOC_CAP_EMMC
                       | UIOX_SOC_CAP_ETH      | UIOX_SOC_CAP_UART
                       | UIOX_SOC_CAP_SBI      | UIOX_SOC_CAP_DTB;

    printf("[soc/th1520] SoC: %s  CPUs=%u  DRAM=%llu MB\n",
           desc->name, desc->num_cpus,
           (unsigned long long)(desc->dram_size >> 20));

    uiox_clk_ctx_t *clk = uiox_soc_get_clk();
    uiox_soc_clk_init(clk, desc);

    th1520_clint_init(0u);
    th1520_plic_init();
    th1520_uart_init();

    uiox_pm_ctx_t *pm = uiox_soc_get_pm();
    uiox_soc_pm_init(pm, desc);

    /* Enable S-mode external interrupts */
    uint64_t sie = rv64_csrr(sie);
    rv64_csrw(sie, sie | (1u << 9));

    desc->initialized = true;
    printf("[soc/th1520] T-Head TH1520 SoC layer ready.\n");
    return UIOX_SOC_OK;
}
