# =============================================================================
# 30_KIX/30_DeviceDrivers/Makefile  — v2.4.0
#
# UIOX Device Drivers — master Makefile (Linux + macOS).
# Builds libdev.a for the selected architecture.
#
# Usage (matches 20_DriverInterfaces / 33_PCS / 32_FS / 10_BSP pattern):
#   make arm64 / arm32 / riscv64 / x86_64
#   make all                     # all four architectures
#   make clean[-arm64|-arm32|-riscv64|-x86_64]
#   make info[-arm64|-arm32|-riscv64|-x86_64]
#
# Called by the 30_KIX umbrella Makefile with:
#   make -C 30_DeviceDrivers CC=<cross> AR=<cross-ar> \
#       ARCH_CFLAGS="<arch flags>" ARCH_CPUDEF="<-D flags>" <arch>
#
# Directory layout (exact structure provided by user):
#   30_DeviceDrivers/
#   ├── 01_Com/          bt  eth  hdmi  monitor  tb4  usb
#   ├── 02_Sensors/      WiFI  als  keyboard  mic  mouse  thermal  touchpwd
#   └── 03_NonSecnsors/  bms  chg  fan  pmic  rtc  speaker
#
# v2.2.0: added 31_BufferCache/01_DrvBuff paths to COMMON_INCLUDES
# v2.3.0: added bt, camera, usb to BUF* paths
# v2.4.0: added all remaining 01_DrvBuff subdirs (chg, emmc, eth, fan, gpu,
#         hdmi, keyboard, mic, mouse, pmic, rtc, speaker, tb4, thermal)
# @version 2.4.0  @date 2026-07-25
# =============================================================================

# ── Makefile-relative base ────────────────────────────────────────────────────
MFDIR    := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
COMMONDIR := $(abspath $(MFDIR)../common)

# ── Host OS detection ─────────────────────────────────────────────────────────
UNAME_S := $(shell uname -s)

ifeq ($(UNAME_S),Darwin)
  LLVM_BIN := $(shell \
    if command -v llvm-objcopy >/dev/null 2>&1; then \
        dirname $$(command -v llvm-objcopy); \
    else \
        echo $$(brew --prefix llvm 2>/dev/null || echo /opt/homebrew/opt/llvm)/bin; \
    fi)
  ARM64_CC := aarch64-elf-gcc
  ARM64_AR := aarch64-elf-ar
  ARM32_CC := arm-none-eabi-gcc
  ARM32_AR := arm-none-eabi-ar
  RV64_CC  := riscv64-elf-gcc
  RV64_AR  := riscv64-elf-ar
  X86_CC   := x86_64-elf-gcc
  X86_AR   := x86_64-elf-ar
else
  ARM64_CC := aarch64-linux-gnu-gcc
  ARM64_AR := aarch64-linux-gnu-ar
  ARM32_CC := arm-linux-gnueabihf-gcc
  ARM32_AR := arm-linux-gnueabihf-ar
  RV64_CC  := riscv64-linux-gnu-gcc
  RV64_AR  := riscv64-linux-gnu-ar
  X86_CC   := x86_64-linux-gnu-gcc
  X86_AR   := x86_64-linux-gnu-ar
endif


# ── Common compiler flags ─────────────────────────────────────────────────────
COMMON_CFLAGS := \
  -std=c11              \
  -Wall -Wextra -Werror \
  -ffreestanding        \
  -fno-builtin          \
  -fno-stack-protector  \
  -ffunction-sections   \
  -fdata-sections       \
  -nostdinc             \
  -Os -g

# ── Include paths ─────────────────────────────────────────────────────────────
# 20_DriverInterfaces top-level include
HALTOP  = $(abspath $(MFDIR)../20_DriverInterfaces/include)
# 20_DriverInterfaces peripheral subdirectory headers
HALBT   = $(abspath $(MFDIR)../20_DriverInterfaces/01_Com/bt)
HALETH  = $(abspath $(MFDIR)../20_DriverInterfaces/01_Com/eth)
HALHDMI = $(abspath $(MFDIR)../20_DriverInterfaces/01_Com/hdmi)
HALTB4  = $(abspath $(MFDIR)../20_DriverInterfaces/01_Com/tb4)
HALWIFI = $(abspath $(MFDIR)../20_DriverInterfaces/02_Sensors/WiFi)
HALCAM  = $(abspath $(MFDIR)../20_DriverInterfaces/02_Sensors/camera)
HALMIC  = $(abspath $(MFDIR)../20_DriverInterfaces/02_Sensors/mic)
HALTHM  = $(abspath $(MFDIR)../20_DriverInterfaces/02_Sensors/thermal)
HALTPWD = $(abspath $(MFDIR)../20_DriverInterfaces/02_Sensors/touchpwd)
HALBMS  = $(abspath $(MFDIR)../20_DriverInterfaces/03_NonSecnsors/bms)
HALCHG  = $(abspath $(MFDIR)../20_DriverInterfaces/03_NonSecnsors/chg)
HALEMMC = $(abspath $(MFDIR)../20_DriverInterfaces/03_NonSecnsors/emmc)
HALFAN  = $(abspath $(MFDIR)../20_DriverInterfaces/03_NonSecnsors/fan)
HALPMIC = $(abspath $(MFDIR)../20_DriverInterfaces/03_NonSecnsors/pmic)
HALRTC  = $(abspath $(MFDIR)../20_DriverInterfaces/03_NonSecnsors/rtc)
HALSPK  = $(abspath $(MFDIR)../20_DriverInterfaces/03_NonSecnsors/speaker)
# 31_BufferCache/01_DrvBuff buffer headers — all subdirs
BUFWIFI = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/WiFi)
BUFALS  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/als)
BUFBMS  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/bms)
BUFMON  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/monitor)
BUFTPWD = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/touchpwd)
BUFBT   = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/bt)
BUFCAM  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/camera)
BUFUSB  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/usb)
BUFETH  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/eth)
BUFCHG  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/chg)
BUFEMMC = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/emmc)
BUFFAN  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/fan)
BUFHDMI = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/hdmi)
BUFKBD  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/keyboard)
BUFMIC  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/mic)
BUFMOU  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/mouse)
BUFPMIC = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/pmic)
BUFRTC  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/rtc)
BUFSPK  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/speaker)
BUFTB4  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/tb4)
BUFTHM  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/thermal)
BUFGPU  = $(abspath $(MFDIR)../31_BufferCache/01_DrvBuff/gpu)

COMMON_INCLUDES := \
  -I$(COMMONDIR)                           \
  -I$(HALTOP)                           \
  -I$(HALBT)                            \
  -I$(HALETH)                           \
  -I$(HALHDMI)                          \
  -I$(HALTB4)                           \
  -I$(HALWIFI)                          \
  -I$(HALCAM)                           \
  -I$(HALMIC)                           \
  -I$(HALTHM)                           \
  -I$(HALTPWD)                          \
  -I$(HALBMS)                           \
  -I$(HALCHG)                           \
  -I$(HALEMMC)                          \
  -I$(HALFAN)                           \
  -I$(HALPMIC)                          \
  -I$(HALRTC)                           \
  -I$(HALSPK)                           \
  -I$(BUFWIFI)                          \
  -I$(BUFALS)                           \
  -I$(BUFBMS)                           \
  -I$(BUFMON)                           \
  -I$(BUFTPWD)                          \
  -I$(BUFBT)                            \
  -I$(BUFCAM)                           \
  -I$(BUFUSB)                           \
  -I$(BUFETH)                           \
  -I$(BUFCHG)                           \
  -I$(BUFEMMC)                          \
  -I$(BUFFAN)                           \
  -I$(BUFHDMI)                          \
  -I$(BUFKBD)                           \
  -I$(BUFMIC)                           \
  -I$(BUFMOU)                           \
  -I$(BUFPMIC)                          \
  -I$(BUFRTC)                           \
  -I$(BUFSPK)                           \
  -I$(BUFTB4)                           \
  -I$(BUFTHM)                           \
  -I$(BUFGPU)                           \
  -I$(MFDIR)01_Com/bt                   \
  -I$(MFDIR)01_Com/eth                  \
  -I$(MFDIR)01_Com/hdmi                 \
  -I$(MFDIR)01_Com/monitor              \
  -I$(MFDIR)01_Com/tb4                  \
  -I$(MFDIR)01_Com/usb                  \
  -I$(MFDIR)02_Sensors/WiFI             \
  -I$(MFDIR)02_Sensors/als              \
  -I$(MFDIR)02_Sensors/keyboard         \
  -I$(MFDIR)02_Sensors/mic              \
  -I$(MFDIR)02_Sensors/mouse            \
  -I$(MFDIR)02_Sensors/thermal          \
  -I$(MFDIR)02_Sensors/touchpwd         \
  -I$(MFDIR)03_NonSecnsors/bms          \
  -I$(MFDIR)03_NonSecnsors/chg          \
  -I$(MFDIR)03_NonSecnsors/fan          \
  -I$(MFDIR)03_NonSecnsors/pmic         \
  -I$(MFDIR)03_NonSecnsors/rtc          \
  -I$(MFDIR)03_NonSecnsors/speaker

# ── Source files ──────────────────────────────────────────────────────────────
DEV_SRCS_C :=
# 01_Com
DEV_SRCS_C += $(wildcard $(MFDIR)01_Com/bt/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)01_Com/eth/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)01_Com/hdmi/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)01_Com/monitor/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)01_Com/tb4/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)01_Com/usb/*.c)
# 02_Sensors
DEV_SRCS_C += $(wildcard $(MFDIR)02_Sensors/WiFI/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)02_Sensors/als/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)02_Sensors/keyboard/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)02_Sensors/mic/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)02_Sensors/mouse/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)02_Sensors/thermal/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)02_Sensors/touchpwd/*.c)
# 03_NonSecnsors
DEV_SRCS_C += $(wildcard $(MFDIR)03_NonSecnsors/bms/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)03_NonSecnsors/chg/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)03_NonSecnsors/fan/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)03_NonSecnsors/pmic/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)03_NonSecnsors/rtc/*.c)
DEV_SRCS_C += $(wildcard $(MFDIR)03_NonSecnsors/speaker/*.c)

# ── vpath ─────────────────────────────────────────────────────────────────────
vpath %.c \
  $(MFDIR)01_Com/bt             \
  $(MFDIR)01_Com/eth            \
  $(MFDIR)01_Com/hdmi           \
  $(MFDIR)01_Com/monitor        \
  $(MFDIR)01_Com/tb4            \
  $(MFDIR)01_Com/usb            \
  $(MFDIR)02_Sensors/WiFI       \
  $(MFDIR)02_Sensors/als        \
  $(MFDIR)02_Sensors/keyboard   \
  $(MFDIR)02_Sensors/mic        \
  $(MFDIR)02_Sensors/mouse      \
  $(MFDIR)02_Sensors/thermal    \
  $(MFDIR)02_Sensors/touchpwd   \
  $(MFDIR)03_NonSecnsors/bms    \
  $(MFDIR)03_NonSecnsors/chg    \
  $(MFDIR)03_NonSecnsors/fan    \
  $(MFDIR)03_NonSecnsors/pmic   \
  $(MFDIR)03_NonSecnsors/rtc    \
  $(MFDIR)03_NonSecnsors/speaker

ARFLAGS := rcs

# =============================================================================
# Per-architecture named targets
# =============================================================================

.PHONY: arm64
arm64: _do_arm64
	@echo "[DEV] arm64 done → build/arm64/"

.PHONY: _do_arm64
_do_arm64:
	@command -v $(ARM64_CC) >/dev/null 2>&1 || \
	    { echo "ERROR: $(ARM64_CC) not found"; \
	      echo "  Linux: sudo apt install gcc-aarch64-linux-gnu"; \
	      echo "  macOS: brew install aarch64-elf-gcc"; exit 1; }
	$(MAKE) -f $(MFDIR)Makefile _build              \
	    _ARCH=arm64                                  \
	    CC=$(ARM64_CC) AR=$(ARM64_AR)               \
	    ARCH_CFLAGS="-march=armv8-a -mabi=lp64 -mlittle-endian" \
	    ARCH_CPUDEF="-D__aarch64__"

.PHONY: arm32
arm32: _do_arm32
	@echo "[DEV] arm32 done → build/arm32/"

.PHONY: _do_arm32
_do_arm32:
	@command -v $(ARM32_CC) >/dev/null 2>&1 || \
	    { echo "ERROR: $(ARM32_CC) not found"; \
	      echo "  Linux: sudo apt install gcc-arm-linux-gnueabihf"; \
	      echo "  macOS: brew install arm-none-eabi-gcc"; exit 1; }
	$(MAKE) -f $(MFDIR)Makefile _build                    \
	    _ARCH=arm32                                        \
	    CC=$(ARM32_CC) AR=$(ARM32_AR)                     \
	    ARCH_CFLAGS="-march=armv7-a -marm -mfloat-abi=soft -mlittle-endian" \
	    ARCH_CPUDEF="-D__arm__"

.PHONY: riscv64
riscv64: _do_riscv64
	@echo "[DEV] riscv64 done → build/riscv64/"

.PHONY: _do_riscv64
_do_riscv64:
	@command -v $(RV64_CC) >/dev/null 2>&1 || \
	    { echo "ERROR: $(RV64_CC) not found"; \
	      echo "  Linux: sudo apt install gcc-riscv64-linux-gnu"; \
	      echo "  macOS: brew install riscv64-elf-gcc"; exit 1; }
	$(MAKE) -f $(MFDIR)Makefile _build                          \
	    _ARCH=riscv64                                            \
	    CC=$(RV64_CC) AR=$(RV64_AR)                             \
	    ARCH_CFLAGS="-march=rv64imafdc_zicsr_zifencei -mabi=lp64d -mcmodel=medany" \
	    ARCH_CPUDEF="-D__riscv -D__riscv_xlen=64"

.PHONY: x86_64
x86_64: _do_x86_64
	@echo "[DEV] x86_64 done → build/x86_64/"

.PHONY: _do_x86_64
_do_x86_64:
	@command -v $(X86_CC) >/dev/null 2>&1 || \
	    { echo "ERROR: $(X86_CC) not found"; \
	      echo "  Linux: sudo apt install gcc-x86-64-linux-gnu"; \
	      echo "  macOS: brew install x86_64-elf-gcc"; exit 1; }
	$(MAKE) -f $(MFDIR)Makefile _build                               \
	    _ARCH=x86_64                                                  \
	    CC=$(X86_CC) AR=$(X86_AR)                                    \
	    ARCH_CFLAGS="-m64 -mno-red-zone -mno-mmx -mno-sse -mno-sse2 -fno-pic -mcmodel=kernel" \
	    ARCH_CPUDEF="-D__x86_64__"

# =============================================================================
# Internal _build target
# =============================================================================
_BUILD_DIR = $(MFDIR)build/$(_ARCH)

_CFLAGS_ALL = $(COMMON_CFLAGS)   \
              $(COMMON_INCLUDES)  \
              $(ARCH_CFLAGS)      \
              $(ARCH_CPUDEF)

_OBJS    = $(patsubst $(MFDIR)%.c,$(_BUILD_DIR)/%.o,$(DEV_SRCS_C))
DEPFLAGS = -MMD -MP -MF $(@:.o=.d)
-include $(_OBJS:.o=.d)

.PHONY: _build
_build: $(_BUILD_DIR)/libdev.a
	@echo "[DEV] _build done: $(_ARCH)"

$(_BUILD_DIR)/libdev.a: $(_OBJS)
	@mkdir -p $(dir $@)
	$(AR) $(ARFLAGS) $@ $^
	@echo "  [AR]  $@"

$(_BUILD_DIR)/%.o: $(MFDIR)%.c
	@mkdir -p $(dir $@)
	$(CC) $(_CFLAGS_ALL) $(DEPFLAGS) -c $< -o $@
	@echo "  [CC]  $<"

# =============================================================================
# Convenience targets
# =============================================================================

.PHONY: all
all: arm64 arm32 riscv64 x86_64
	@echo "" && echo "[DEV] all builds complete"

.PHONY: clean-arm64 clean-arm32 clean-riscv64 clean-x86_64 clean
clean-arm64:   ; rm -rf $(MFDIR)build/arm64
clean-arm32:   ; rm -rf $(MFDIR)build/arm32
clean-riscv64: ; rm -rf $(MFDIR)build/riscv64
clean-x86_64:  ; rm -rf $(MFDIR)build/x86_64
clean: clean-arm64 clean-arm32 clean-riscv64 clean-x86_64
	@echo "[CLN] all build outputs removed"

.PHONY: info-arm64 info-arm32 info-riscv64 info-x86_64
info-arm64:
	@echo "HOST=$(UNAME_S) ARCH=arm64   CC=$(ARM64_CC)"
info-arm32:
	@echo "HOST=$(UNAME_S) ARCH=arm32   CC=$(ARM32_CC)"
info-riscv64:
	@echo "HOST=$(UNAME_S) ARCH=riscv64 CC=$(RV64_CC)"
info-x86_64:
	@echo "HOST=$(UNAME_S) ARCH=x86_64  CC=$(X86_CC)"
