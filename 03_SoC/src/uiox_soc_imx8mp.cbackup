/*
 * 02_FwHal/src/uiox_soc_imx8mp.c
 * UIOX SoC abstraction — NXP i.MX 8M Plus (ARM64) backend.
 *
 * The i.MX 8M Plus is a quad-core Cortex-A53 SoC with:
 *   - GIC-500 distributor at 0x38800000
 *   - UART1 (i.MX lpuart) at 0x30860000
 *   - CCM (Clock Controller Module) at 0x30380000
 *   - GPC (General Power Controller) at 0x303A0000
 *   - DDR controller at 0x3D400000
 *   - PCIe at 0x33800000
 *   - USB at 0x38100000
 *   - eMMC (uSDHC) at 0x30B40000
 *
 * Ref: NXP i.MX 8M Plus Applications Processor Reference Manual
 *      (document IMX8MPRM, Rev 1, 2021)
 */

 #include "../include/uiox_soc.h"
 #include "../../10_Arch/arm64/include/arch_defs.h"
 #include "../../20_DriverInterfaces/include/hw_types.h"
 #include "../../20_DriverInterfaces/include/mmio.h"
 #include "../../20_DriverInterfaces/include/irq.h"
 #include <stdio.h>
 #include <string.h>
 
 /* =========================================================================
  * i.MX 8M Plus MMIO addresses
  * ====================================================================== */
 
 /* GIC-500 */
 #define IMX8MP_GIC_DIST_BASE    0x38800000UL
 #define IMX8MP_GIC_CPU_BASE     0x38810000UL
 #define IMX8MP_GIC_REDIST_BASE  0x38880000UL
 
 /* UART1 (lpuart — i.MX UART, not PL011) */
 #define IMX8MP_UART1_BASE       0x30860000UL
 #define IMX8MP_UART1_IRQ        26u   /* SPI 26 = IRQ 58 */
 
 /* CCM (Clock Controller Module) */
 #define IMX8MP_CCM_BASE         0x30380000UL
 #define IMX8MP_CCM_CCGR0        (IMX8MP_CCM_BASE + 0x4000u)
 #define IMX8MP_CCM_CCGR1        (IMX8MP_CCM_BASE + 0x4010u)
 #define IMX8MP_CCM_CCGR5        (IMX8MP_CCM_BASE + 0x4050u)
 
 /* GPC (General Power Controller) */
 #define IMX8MP_GPC_BASE         0x303A0000UL
 #define IMX8MP_GPC_CPU_PGC_CTRL (IMX8MP_GPC_BASE + 0x800u)
 
 /* i.MX UART register offsets */
 #define IMX_UART_URXD       0x00u
 #define IMX_UART_UTXD       0x40u
 #define IMX_UART_UCR1       0x80u
 #define IMX_UART_UCR2       0x84u
 #define IMX_UART_UCR3       0x88u
 #define IMX_UART_UCR4       0x8Cu
 #define IMX_UART_UFCR       0x90u
 #define IMX_UART_USR1       0x94u
 #define IMX_UART_USR2       0x98u
 #define IMX_UART_UBIR       0xA4u
 #define IMX_UART_UBMR       0xA8u
 #define IMX_UART_UTS        0xB4u
 
 /* =========================================================================
  * CCM — enable clocks for UART1, GIC, DDR, USB, PCIe
  * ====================================================================== */
 static void imx8mp_ccm_init(void)
 {
     /* Enable all clocks in CCGR0 and CCGR1 (UART, GIC, DDR) */
     mmio_write32(IMX8MP_CCM_CCGR0, 0xFFFFFFFFu);
     mmio_write32(IMX8MP_CCM_CCGR1, 0xFFFFFFFFu);
     mmio_write32(IMX8MP_CCM_CCGR5, 0xFFFFFFFFu);
     printf("[soc/imx8mp] CCM clocks enabled\n");
 }
 
 /* =========================================================================
  * GIC-500 init (distributor + redistributor)
  * ====================================================================== */
 static void imx8mp_gic_init(void)
 {
     /* Disable GICD before configuration */
     mmio_write32(IMX8MP_GIC_DIST_BASE + 0x000u, 0x0u);
 
     /* Enable all SPI interrupts (banks 1..n) */
     for (uint32_t i = 0u; i < 8u; i++)
         mmio_write32(IMX8MP_GIC_DIST_BASE + 0x100u + i * 4u,
                      0xFFFFFFFFu);
 
     /* Set all interrupt priorities to mid-level */
     for (uint32_t i = 0u; i < 64u; i++)
         mmio_write32(IMX8MP_GIC_DIST_BASE + 0x400u + i * 4u,
                      0xA0A0A0A0u);
 
     /* CPU interface: allow all priorities */
     mmio_write32(IMX8MP_GIC_CPU_BASE + 0x004u, 0xFFu);
     mmio_write32(IMX8MP_GIC_CPU_BASE + 0x000u, 0x1u);
 
     /* Enable GICD with Group1 */
     mmio_write32(IMX8MP_GIC_DIST_BASE + 0x000u, 0x3u);
     printf("[soc/imx8mp] GIC-500 init (DIST=0x%08lx REDIST=0x%08lx)\n",
            (unsigned long)IMX8MP_GIC_DIST_BASE,
            (unsigned long)IMX8MP_GIC_REDIST_BASE);
 }
 
 /* =========================================================================
  * i.MX UART1 init — 115200 8N1
  * The i.MX UART uses UBIR/UBMR for baud rather than PL011 IBRD/FBRD.
  * BAUD = (RefClk / 16) × (UBIR + 1) / (UBMR + 1)
  * RefClk = 24 MHz → UBMR=3124, UBIR=11 → ~115200
  * ====================================================================== */
 static void imx8mp_uart_init(void)
 {
     /* Disable UART */
     mmio_write32(IMX8MP_UART1_BASE + IMX_UART_UCR1, 0x0u);
 
     /* UCR2: TX/RX enable, 8-bit, 1 stop, no parity */
     mmio_write32(IMX8MP_UART1_BASE + IMX_UART_UCR2, 0x4026u);
 
     /* UCR3: RXDMUXSEL must be set on i.MX8 */
     mmio_write32(IMX8MP_UART1_BASE + IMX_UART_UCR3, 0x0784u);
 
     /* UCR4: CTSTL = 32 */
     mmio_write32(IMX8MP_UART1_BASE + IMX_UART_UCR4, 0x8000u);
 
     /* UFCR: RXTL=1, DCEDTE=0, RFDIV=/2, TXTL=2 */
     mmio_write32(IMX8MP_UART1_BASE + IMX_UART_UFCR, 0x0801u);
 
     /* Baud: 24 MHz ref, 115200 baud */
     mmio_write32(IMX8MP_UART1_BASE + IMX_UART_UBIR, 11u);
     mmio_write32(IMX8MP_UART1_BASE + IMX_UART_UBMR, 3124u);
 
     /* Enable UART */
     mmio_write32(IMX8MP_UART1_BASE + IMX_UART_UCR1, 0x0001u);
 
     printf("[soc/imx8mp] i.MX UART1 @ 0x%08lx  115200 8N1\n",
            (unsigned long)IMX8MP_UART1_BASE);
 }
 
 /* =========================================================================
  * uiox_soc_init_imx8mp
  * ====================================================================== */
 int uiox_soc_init_imx8mp(uiox_soc_desc_t *desc)
 {
     if (!desc) return UIOX_SOC_ERR_INVAL;
 
     printf("[soc/imx8mp] Initialising NXP i.MX 8M Plus SoC layer...\n");
 
     strncpy(desc->name, "NXP i.MX 8M Plus (Cortex-A53)",
             UIOX_SOC_NAME_LEN - 1);
     desc->soc_id       = UIOX_SOC_IMX8MP;
     desc->num_cpus     = 4u;
     desc->num_clusters = 1u;
     desc->cpu_freq_khz = 1800000u;   /* 1.8 GHz typical */
     desc->l1_icache_kb = 32u;
     desc->l1_dcache_kb = 32u;
     desc->l2_cache_kb  = 512u;
     desc->l3_cache_kb  = 0u;
     desc->dram_base    = 0x40000000UL;
     desc->dram_size    = 0x80000000UL;   /* 2 GB */
     desc->capabilities = UIOX_SOC_CAP_MMU      | UIOX_SOC_CAP_CACHE_L1
                        | UIOX_SOC_CAP_CACHE_L2 | UIOX_SOC_CAP_SMP
                        | UIOX_SOC_CAP_GIC_V3   | UIOX_SOC_CAP_TRNG
                        | UIOX_SOC_CAP_TRUSTZONE | UIOX_SOC_CAP_SECURE_BOOT
                        | UIOX_SOC_CAP_PCIE      | UIOX_SOC_CAP_USB
                        | UIOX_SOC_CAP_EMMC      | UIOX_SOC_CAP_ETH
                        | UIOX_SOC_CAP_UART      | UIOX_SOC_CAP_PSCI
                        | UIOX_SOC_CAP_DTB;
 
     printf("[soc/imx8mp] SoC: %s  CPUs=%u  DRAM=%llu MB\n",
            desc->name, desc->num_cpus,
            (unsigned long long)(desc->dram_size >> 20));
 
     imx8mp_ccm_init();
 
     uiox_clk_ctx_t *clk = uiox_soc_get_clk();
     uiox_soc_clk_init(clk, desc);
 
     imx8mp_gic_init();
     imx8mp_uart_init();
 
     uiox_pm_ctx_t *pm = uiox_soc_get_pm();
     uiox_soc_pm_init(pm, desc);
 
     desc->initialized = true;
     printf("[soc/imx8mp] NXP i.MX 8M Plus SoC layer ready.\n");
     return UIOX_SOC_OK;
 }
 