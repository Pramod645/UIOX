/**
 * @file    uiox_soc_devsw.c
 * @brief   UIOX SoC — device switch, UART, timer, GPIO, WDT, storage stubs.
 * @date    2026-07-18
 */

 #include "uiox_soc_devsw.h"
 #include "uiox_soc_hw.h"
 #include "uiox_soc.h"
 
 /* =========================================================================
  * UART
  * ====================================================================== */
 
 void uiox_soc_uart_init(uiox_soc_uart_t *u,
                          uiox_uintptr_t   base,
                          uiox_uint32_t    irq,
                          uiox_uint32_t    baud)
 {
     if (!u) return;
     u->base        = base;
     u->irq         = irq;
     u->baud        = baud;
     u->initialized = true;
 }
 
 void uiox_soc_uart_putc(uiox_soc_uart_t *u, char c)
 {
     UIOX_SOC_UNUSED(u);
     uiox_soc_hw_uart_putc(c);
 }
 
 int uiox_soc_uart_getc(uiox_soc_uart_t *u)
 {
     UIOX_SOC_UNUSED(u);
     return -1;   /* no blocking read in bare-metal stub */
 }
 
 void uiox_soc_uart_irq(uiox_soc_uart_t *u)
 {
     UIOX_SOC_UNUSED(u);
     /* Real: read RX FIFO, push into ring buffer */
 }
 
 /* =========================================================================
  * Timer
  * ====================================================================== */
 
 uiox_soc_err_t uiox_soc_timer_init(uiox_soc_timer_t     *t,
                                      uiox_soc_timer_type_t type,
                                      uiox_uintptr_t        base,
                                      uiox_uint32_t         irq,
                                      uiox_uint32_t         hz)
 {
     if (!t || hz == 0u) return UIOX_SOC_ERR_INVAL;
     t->type        = type;
     t->base        = base;
     t->irq         = irq;
     t->hz          = hz;
     t->cb          = NULL;
     t->cb_priv     = NULL;
     t->initialized = true;
 
     /*
      * Hardware programming:
      *   ARM GT  — write CNTP_TVAL_EL0 = cntfrq / hz; enable via CNTP_CTL
      *   SP804   — write load register, set periodic + IRQ enable bits
      *   PIT     — write divisor to ports 0x40-0x42
      *   CLINT   — write MTIMECMP = MTIME + freq/hz
      * Stub: no hardware access on QEMU (bootloader already configured it).
      */
     SOC_LOG("TIMER", "type=%u  irq=%u  %u Hz", (unsigned)type, irq, hz);
     return UIOX_SOC_OK;
 }
 
 void uiox_soc_timer_set_cb(uiox_soc_timer_t    *t,
                              uiox_soc_timer_cb_t  cb,
                              void                *priv)
 {
     if (!t) return;
     t->cb      = cb;
     t->cb_priv = priv;
 }
 
 void uiox_soc_timer_irq(uiox_soc_timer_t *t)
 {
     if (!t || !t->cb) return;
     t->cb(t->cb_priv);
 }
 
 /* =========================================================================
  * GPIO
  * ====================================================================== */
 
 uiox_soc_err_t uiox_soc_gpio_init(uiox_soc_gpio_t *g,
                                     uiox_uintptr_t   base,
                                     uiox_uint32_t    irq,
                                     uiox_uint32_t    num_pins)
 {
     if (!g) return UIOX_SOC_ERR_INVAL;
     g->base        = base;
     g->irq         = irq;
     g->num_pins    = num_pins;
     g->initialized = true;
     SOC_LOG("GPIO", "base=0x%llx  irq=%u  pins=%u",
             (unsigned long long)base, irq, num_pins);
     return UIOX_SOC_OK;
 }
 
 /* =========================================================================
  * Watchdog
  * ====================================================================== */
 
 static uiox_uintptr_t s_wdt_base    = 0u;
 static uiox_uint32_t  s_wdt_load    = 0u;
 
 uiox_soc_err_t uiox_soc_wdt_init(uiox_uintptr_t base,
                                    uiox_uint32_t  ref_hz,
                                    uiox_uint32_t  timeout_ms)
 {
     if (base == 0u || ref_hz == 0u) return UIOX_SOC_ERR_INVAL;
     s_wdt_base = base;
     s_wdt_load = (uiox_uint32_t)(((uiox_uint64_t)ref_hz * timeout_ms)
                                   / 1000u);
     /*
      * SP805 WDT programming (ARM SP805 / ARM PrimeCell):
      *   Unlock:  WDOGLOCK = 0x1ACCE551
      *   Load:    WDOGLOAD = s_wdt_load
      *   Control: WDOGCONTROL = 0x3 (reset + interrupt enable)
      *   Lock:    WDOGLOCK = 0
      */
     if (base) {
         soc_mmio_write32(base + 0xC00u, 0x1ACCE551u); /* unlock          */
         soc_mmio_write32(base + 0x000u, s_wdt_load);  /* load            */
         soc_mmio_write32(base + 0x008u, 0x3u);        /* enable + reset  */
         soc_mmio_write32(base + 0xC00u, 0x0u);        /* lock            */
     }
     SOC_LOG("WDT", "base=0x%llx  timeout=%u ms",
             (unsigned long long)base, timeout_ms);
     return UIOX_SOC_OK;
 }
 
 void uiox_soc_wdt_kick(void)
 {
     if (s_wdt_base == 0u) return;
     soc_mmio_write32(s_wdt_base + 0xC00u, 0x1ACCE551u); /* unlock        */
     soc_mmio_write32(s_wdt_base + 0x000u, s_wdt_load);  /* reload        */
     soc_mmio_write32(s_wdt_base + 0xC00u, 0x0u);        /* lock          */
 }
 
 /* =========================================================================
  * I2C / SPI stubs
  * ====================================================================== */
 
 uiox_soc_err_t uiox_soc_i2c_init_dw(uiox_uintptr_t       base,
                                       uiox_uint32_t        ref_hz,
                                       uiox_uint32_t        irq,
                                       uiox_soc_i2c_speed_t speed)
 {
     UIOX_SOC_UNUSED(base); UIOX_SOC_UNUSED(ref_hz);
     UIOX_SOC_UNUSED(irq);  UIOX_SOC_UNUSED(speed);
     SOC_LOG("I2C", "DW init stub");
     return UIOX_SOC_OK;
 }
 
 uiox_soc_err_t uiox_soc_spi_init_pl022(uiox_uintptr_t base,
                                          uiox_uint32_t  ref_hz,
                                          uiox_uint32_t  irq)
 {
     UIOX_SOC_UNUSED(base); UIOX_SOC_UNUSED(ref_hz); UIOX_SOC_UNUSED(irq);
     SOC_LOG("SPI", "PL022 init stub");
     return UIOX_SOC_OK;
 }
 
 /* =========================================================================
  * Storage
  * ====================================================================== */
 
 static uiox_soc_stor_dev_t *s_stor[UIOX_SOC_STOR_MAX_DEVS];
 static uiox_uint32_t        s_stor_count = 0u;
 
 void uiox_soc_stor_init(void)
 {
     for (uiox_uint32_t i = 0u; i < UIOX_SOC_STOR_MAX_DEVS; i++)
         s_stor[i] = NULL;
     s_stor_count = 0u;
 }
 
 uiox_soc_err_t uiox_soc_stor_register(uiox_soc_stor_dev_t *dev)
 {
     if (!dev || s_stor_count >= UIOX_SOC_STOR_MAX_DEVS)
         return UIOX_SOC_ERR_FULL;
     s_stor[s_stor_count++] = dev;
     SOC_LOG("STOR", "registered '%s'  %llu sectors × %u B",
             dev->name,
             (unsigned long long)dev->num_sectors,
             dev->sector_size);
     return UIOX_SOC_OK;
 }
 
 void uiox_soc_stor_print(void)
 {
     uiox_soc_printf("[SOC] Storage devices (%u registered):\n", s_stor_count);
     for (uiox_uint32_t i = 0u; i < s_stor_count; i++) {
         const uiox_soc_stor_dev_t *d = s_stor[i];
         if (!d) continue;
         uiox_soc_printf("  [%u] %-12s  %llu sectors  %s\n",
                          i, d->name,
                          (unsigned long long)d->num_sectors,
                          d->read_only ? "RO" : "RW");
     }
 }
 
 /* =========================================================================
  * Device switch table
  * ====================================================================== */
 
 void uiox_soc_devsw_init(uiox_soc_devsw_t *sw)
 {
     if (!sw) return;
     uiox_soc_memset(sw, 0, sizeof(*sw));
     sw->magic = UIOX_SOC_DEVSW_MAGIC;
 }
 
 uiox_soc_err_t uiox_soc_cdev_register(uiox_soc_devsw_t       *sw,
                                         const uiox_soc_cdevsw_t *cdev)
 {
     if (!sw || !cdev || sw->num_cdev >= UIOX_SOC_DEVSW_CDEV_MAX)
         return UIOX_SOC_ERR_FULL;
     sw->cdev[sw->num_cdev++] = *cdev;
     SOC_LOG("DEVSW", "cdev '%s' major=%u registered", cdev->name, cdev->major);
     return UIOX_SOC_OK;
 }
 
 uiox_soc_err_t uiox_soc_bdev_register(uiox_soc_devsw_t       *sw,
                                         const uiox_soc_bdevsw_t *bdev)
 {
     if (!sw || !bdev || sw->num_bdev >= UIOX_SOC_DEVSW_BDEV_MAX)
         return UIOX_SOC_ERR_FULL;
     sw->bdev[sw->num_bdev++] = *bdev;
     SOC_LOG("DEVSW", "bdev '%s' major=%u registered", bdev->name, bdev->major);
     return UIOX_SOC_OK;
 }
 
 void uiox_soc_devsw_print(const uiox_soc_devsw_t *sw)
 {
     if (!sw) return;
     uiox_soc_printf("[SOC] Character devices (%u):\n", sw->num_cdev);
     for (uiox_uint32_t i = 0u; i < sw->num_cdev; i++)
         uiox_soc_printf("  cdev[%u]  major=%-3u  %s  %s\n",
                          i, sw->cdev[i].major, sw->cdev[i].name,
                          sw->cdev[i].ready ? "ready" : "not ready");
 
     uiox_soc_printf("[SOC] Block devices (%u):\n", sw->num_bdev);
     for (uiox_uint32_t i = 0u; i < sw->num_bdev; i++)
         uiox_soc_printf("  bdev[%u]  major=%-3u  %s  %llu blocks\n",
                          i, sw->bdev[i].major, sw->bdev[i].name,
                          (unsigned long long)sw->bdev[i].num_blocks);
 }
 