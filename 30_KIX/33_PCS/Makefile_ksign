# =============================================================================
# 30_KIX/33_PCS/Makefile_ksign  — v1.0.0
#
# UIOX Kernel Signing — builds libksign.a for the selected architecture.
#
# This file sits PARALLEL TO 03_ksign/, not inside it, so the module is
# built the same way the process layer is: from 33_PCS/, by an explicit -f.
#
#   make -f Makefile_ksign arm64 | arm32 | riscv64 | x86_64
#   make -f Makefile_ksign all
#   make -f Makefile_ksign clean[-<arch>]
#   make -f Makefile_ksign info
#
#
# ── SIX sources into 03_ksign/build/<arch>/libksign.a ────────────────────────
#
#   uiox_kix_ksign_crypto.c    SHA-256/384, RSA/ECDSA verify
#   uiox_kix_ksign_key.c       key store, KRL, chain walk
#   uiox_kix_ksign_image.c     header parse, payload hash, sig section
#   uiox_kix_ksign_verify.c    the verification pipeline
#   uiox_kix_ksign_measure.c   PCR log
#   uiox_kix_ksign_runtime.c   runtime monitor + the three sys_* handlers
#
# uiox_kix_ksign.c is NOT built here.  It owns uiox_ks_boot_entry() and the
# five weak platform hooks — a boot-path file called from 02_FwHal Stage 0d.
# Putting it in this archive would give uiox_ks_plat_halt and its siblings a
# second definition, and the linker would pick one by archive order.  Link it
# into the kernel image directly.
#
# ── the signing TOOL is a HOST binary, not built here ────────────────────────
# the host CC, and it needs the v2 format changes on its side or it writes
# images this verifier rejects.
#
# @version 1.0.0  @date 2026-10-01
# =============================================================================

# ── Roots, both anchored at 33_PCS/ ───────────────────────────────────────────
# MFDIR is the directory holding THIS file — which is 33_PCS/, the same
# directory that holds 03_ksign/ and the master Makefile.  One root, no
# arithmetic that can be off by a level.
MFDIR     := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
KSIGNTOP  := $(MFDIR)03_ksign
COMMONDIR := $(abspath $(MFDIR)../common)

# ── Host OS detection ─────────────────────────────────────────────────────────
UNAME_S := $(shell uname -s)

ifeq ($(UNAME_S),Darwin)
  ARM64_CC := aarch64-elf-gcc
  ARM64_AR := aarch64-elf-ar
  ARM32_CC := arm-none-eabi-gcc
  ARM32_AR := arm-none-eabi-ar
  RV64_CC  := riscv64-elf-gcc
  RV64_AR  := riscv64-elf-ar
  X86_CC   := x86_64-elf-gcc
  X86_AR   := x86_64-elf-ar
else
  ARM64_CC := aarch64-linux-gnu-gcc
  ARM64_AR := aarch64-linux-gnu-ar
  ARM32_CC := arm-linux-gnueabihf-gcc
  ARM32_AR := arm-linux-gnueabihf-ar
  RV64_CC  := riscv64-linux-gnu-gcc
  RV64_AR  := riscv64-linux-gnu-ar
  X86_CC   := x86_64-linux-gnu-gcc
  X86_AR   := x86_64-linux-gnu-ar
endif

# ── Include paths ─────────────────────────────────────────────────────────────
# This module names no 33_PCS layer type — no uiox_kix_psa_*, no
# uiox_kix_scpcs_*, no sched_types.h.  So the only include dirs are its own
# and common/, which is where uiox_klibc.h lives.
KSIGN_INCLUDES := \
  -I$(KSIGNTOP)/include \
  -I$(COMMONDIR)

# ── Compiler flags ────────────────────────────────────────────────────────────
COMMON_CFLAGS := \
  -std=c11              \
  -Wall -Wextra -Werror \
  -ffreestanding        \
  -fno-builtin          \
  -fno-stack-protector  \
  -ffunction-sections   \
  -fdata-sections       \
  -Os -g

# ── Sources ───────────────────────────────────────────────────────────────────
# Named, not wildcarded: a wildcard would sweep in uiox_kix_ksign.c, which is
# deliberately excluded.
KSIGN_SRCS_C := \
  $(KSIGNTOP)/src/uiox_kix_ksign_crypto.c   \
  $(KSIGNTOP)/src/uiox_kix_ksign_key.c      \
  $(KSIGNTOP)/src/uiox_kix_ksign_image.c    \
  $(KSIGNTOP)/src/uiox_kix_ksign_verify.c   \
  $(KSIGNTOP)/src/uiox_kix_ksign_measure.c  \
  $(KSIGNTOP)/src/uiox_kix_ksign_runtime.c

BUILD_BASE = $(KSIGNTOP)/build
ARFLAGS    := rcs

# =============================================================================
# Per-architecture targets
# =============================================================================

.PHONY: arm64
arm64: _do_arm64
	@echo "[KSIGN] arm64 done -> 03_ksign/build/arm64/"

.PHONY: _do_arm64
_do_arm64:
	@command -v $(ARM64_CC) >/dev/null 2>&1 || \
	    { echo "ERROR: $(ARM64_CC) not found"; \
	      echo "  Linux: sudo apt install gcc-aarch64-linux-gnu"; \
	      echo "  macOS: brew install aarch64-elf-gcc"; exit 1; }
	$(MAKE) -f $(MFDIR)Makefile_ksign _build   \
	    _ARCH=arm64                             \
	    CC=$(ARM64_CC) AR=$(ARM64_AR)           \
	    ARCH_CFLAGS="-march=armv8-a -mabi=lp64 -mlittle-endian" \
	    ARCH_CPUDEF="-D__aarch64__"

.PHONY: arm32
arm32: _do_arm32
	@echo "[KSIGN] arm32 done -> 03_ksign/build/arm32/"

.PHONY: _do_arm32
_do_arm32:
	@command -v $(ARM32_CC) >/dev/null 2>&1 || \
	    { echo "ERROR: $(ARM32_CC) not found"; \
	      echo "  Linux: sudo apt install gcc-arm-linux-gnueabihf"; \
	      echo "  macOS: brew install arm-none-eabi-gcc"; exit 1; }
	$(MAKE) -f $(MFDIR)Makefile_ksign _build    \
	    _ARCH=arm32                              \
	    CC=$(ARM32_CC) AR=$(ARM32_AR)            \
	    ARCH_CFLAGS="-march=armv7-a -marm -mfloat-abi=soft -mlittle-endian" \
	    ARCH_CPUDEF="-D__arm__"

.PHONY: riscv64
riscv64: _do_riscv64
	@echo "[KSIGN] riscv64 done -> 03_ksign/build/riscv64/"

.PHONY: _do_riscv64
_do_riscv64:
	@command -v $(RV64_CC) >/dev/null 2>&1 || \
	    { echo "ERROR: $(RV64_CC) not found"; \
	      echo "  Linux: sudo apt install gcc-riscv64-linux-gnu"; \
	      echo "  macOS: brew install riscv64-elf-gcc"; exit 1; }
	$(MAKE) -f $(MFDIR)Makefile_ksign _build                      \
	    _ARCH=riscv64                                             \
	    CC=$(RV64_CC) AR=$(RV64_AR)                               \
	    ARCH_CFLAGS="-march=rv64imafdc_zicsr_zifencei -mabi=lp64d -mcmodel=medany" \
	    ARCH_CPUDEF="-D__riscv -D__riscv_xlen=64"

.PHONY: x86_64
x86_64: _do_x86_64
	@echo "[KSIGN] x86_64 done -> 03_ksign/build/x86_64/"

.PHONY: _do_x86_64
_do_x86_64:
	@command -v $(X86_CC) >/dev/null 2>&1 || \
	    { echo "ERROR: $(X86_CC) not found"; \
	      echo "  Linux: sudo apt install gcc-x86-64-linux-gnu"; \
	      echo "  macOS: brew install x86_64-elf-gcc"; exit 1; }
	$(MAKE) -f $(MFDIR)Makefile_ksign _build                          \
	    _ARCH=x86_64                                                   \
	    CC=$(X86_CC) AR=$(X86_AR)                                     \
	    ARCH_CFLAGS="-m64 -mno-red-zone -mno-mmx -mno-sse -mno-sse2 -fno-pic -mcmodel=kernel" \
	    ARCH_CPUDEF="-D__x86_64__"

# =============================================================================
# Internal _build
# =============================================================================
_ARCH      ?= arm64
_BUILD_DIR  = $(BUILD_BASE)/$(_ARCH)

_CFLAGS_ALL = $(COMMON_CFLAGS)   \
              $(KSIGN_INCLUDES)  \
              $(ARCH_CFLAGS)     \
              $(ARCH_CPUDEF)

# Objects mirror the module path under build/<arch>/:
#   03_ksign/src/uiox_kix_ksign_key.c -> 03_ksign/build/arm64/src/uiox_kix_ksign_key.o
_OBJS = $(patsubst $(KSIGNTOP)/%.c,$(_BUILD_DIR)/%.o,$(KSIGN_SRCS_C))

DEPFLAGS = -MMD -MP -MF $(@:.o=.d)
-include $(_OBJS:.o=.d)

.PHONY: _build
_build: $(_BUILD_DIR)/libksign.a
	@echo "[KSIGN] _build done: $(_ARCH)  ($(words $(_OBJS)) objects)"

$(_BUILD_DIR)/libksign.a: $(_OBJS)
	@mkdir -p $(dir $@)
	$(AR) $(ARFLAGS) $@ $^
	@echo "  [AR]  $@"

$(_BUILD_DIR)/%.o: $(KSIGNTOP)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(_CFLAGS_ALL) -I$(dir $<) $(DEPFLAGS) -c $< -o $@
	@echo "  [CC]  $<"

# =============================================================================
# Convenience
# =============================================================================

.PHONY: all
all: arm64 arm32 riscv64 x86_64
	@echo ""
	@echo "[KSIGN] all builds complete"

.PHONY: clean-arm64 clean-arm32 clean-riscv64 clean-x86_64 clean
clean-arm64:   ; rm -rf $(BUILD_BASE)/arm64
clean-arm32:   ; rm -rf $(BUILD_BASE)/arm32
clean-riscv64: ; rm -rf $(BUILD_BASE)/riscv64
clean-x86_64:  ; rm -rf $(BUILD_BASE)/x86_64
clean: clean-arm64 clean-arm32 clean-riscv64 clean-x86_64
	@echo "[CLN] ksign build outputs removed"

.PHONY: info
info:
	@echo "MFDIR     = $(MFDIR)"
	@echo "KSIGNTOP  = $(KSIGNTOP)"
	@echo "COMMONDIR = $(COMMONDIR)"
	@echo ""
	@echo "libksign.a sources (6):"
	@for f in $(KSIGN_SRCS_C) ; do \
	    [ -f "$$f" ] && echo "  OK   $$f" || echo "  MISS $$f" ; done
	@echo ""
	@echo "excluded deliberately:"
	@echo "  skip $(KSIGNTOP)/src/uiox_kix_ksign.c"
	@echo ""
	@echo "headers expected:"
	@for h in uiox_kix_ksign_types.h uiox_kix_ksign_crypto.h \
	          uiox_kix_ksign_key.h   uiox_kix_ksign_image.h \
	          uiox_kix_ksign_verify.h uiox_kix_ksign_measure.h \
	          uiox_kix_ksign_runtime.h uiox_kix_ksign.h ; do \
	    [ -f "$(KSIGNTOP)/include/$$h" ] && echo "  OK   include/$$h" \
	                                     || echo "  MISS include/$$h" ; done
	@echo ""
	@echo "object count: $(words $(_OBJS))"
