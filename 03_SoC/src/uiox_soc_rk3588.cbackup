/*
 * 02_FwHal/src/uiox_soc_rk3588.c
 * UIOX SoC abstraction — Rockchip RK3588 (ARM64) backend.
 *
 * The RK3588 is an octa-core big.LITTLE SoC:
 *   - 4× Cortex-A76 (big)  + 4× Cortex-A55 (LITTLE)
 *   - GIC-600 at 0xFE600000
 *   - UART2 (8250-compatible) at 0xFEB50000
 *   - CRU (Clock/Reset Unit) at 0xFD7C0000
 *   - PMU (Power Management Unit) at 0xFD8D0000
 *   - PCIe 3.0 at 0xF5000000
 *   - USB3 OTG at 0xFC000000
 *   - eMMC at 0xFE2E0000
 *
 * Ref: Rockchip RK3588 TRM (Technical Reference Manual) v1.0
 */

 #include "../include/uiox_soc.h"
 #include "../../10_Arch/arm64/include/arch_defs.h"
 #include "../../20_DriverInterfaces/include/hw_types.h"
 #include "../../20_DriverInterfaces/include/mmio.h"
 #include "../../20_DriverInterfaces/include/irq.h"
 #include <stdio.h>
 #include <string.h>
 
 /* =========================================================================
  * RK3588 MMIO addresses
  * ====================================================================== */
 
 /* GIC-600 */
 #define RK3588_GIC_DIST_BASE    0xFE600000UL
 #define RK3588_GIC_CPU_BASE     0xFE610000UL
 #define RK3588_GIC_REDIST_BASE  0xFE680000UL
 
 /* UART2 (16550-compatible, 8250) */
 #define RK3588_UART2_BASE       0xFEB50000UL
 #define RK3588_UART2_IRQ        333u   /* GIC SPI 333 */
 
 /* CRU (Clock/Reset Unit) */
 #define RK3588_CRU_BASE         0xFD7C0000UL
 #define RK3588_CRU_CLKGATE0    (RK3588_CRU_BASE + 0x0300u)
 #define RK3588_CRU_CLKGATE1    (RK3588_CRU_BASE + 0x0304u)
 #define RK3588_CRU_SOFTRST0    (RK3588_CRU_BASE + 0x0400u)
 
 /* PMU */
 #define RK3588_PMU_BASE         0xFD8D0000UL
 #define RK3588_PMU_PWRDN_ST    (RK3588_PMU_BASE + 0x0098u)
 
 /* =========================================================================
  * CRU — ungate clocks for UART, GIC, eMMC, USB
  * ====================================================================== */
 static void rk3588_cru_init(void)
 {
     /* RK3588 clock gates: write 1 to the low 16 bits to ENABLE,
      * bit 16+n acts as write-mask. Writing 0x0000FFFF enables all. */
     mmio_write32(RK3588_CRU_CLKGATE0, 0x00000000u);
     mmio_write32(RK3588_CRU_CLKGATE1, 0x00000000u);
     printf("[soc/rk3588] CRU clocks enabled\n");
 }
 
 /* =========================================================================
  * GIC-600 init
  * ====================================================================== */
 static void rk3588_gic_init(void)
 {
     mmio_write32(RK3588_GIC_DIST_BASE + 0x000u, 0x0u);   /* disable GICD */
 
     /* Enable SPIs (banks 1–16 for 512 SPIs) */
     for (uint32_t i = 0u; i < 16u; i++)
         mmio_write32(RK3588_GIC_DIST_BASE + 0x100u + i * 4u,
                      0xFFFFFFFFu);
 
     /* Set priorities to mid-level */
     for (uint32_t i = 0u; i < 128u; i++)
         mmio_write32(RK3588_GIC_DIST_BASE + 0x400u + i * 4u,
                      0xA0A0A0A0u);
 
     mmio_write32(RK3588_GIC_CPU_BASE + 0x004u, 0xFFu);  /* priority mask */
     mmio_write32(RK3588_GIC_CPU_BASE + 0x000u, 0x1u);   /* enable GICC  */
     mmio_write32(RK3588_GIC_DIST_BASE + 0x000u, 0x3u);  /* enable GICD  */
 
     printf("[soc/rk3588] GIC-600 init (DIST=0x%08lx)\n",
            (unsigned long)RK3588_GIC_DIST_BASE);
 }
 
 /* =========================================================================
  * UART2 init — 16550-compatible, 115200 8N1
  * At 24 MHz UART ref clock: divisor = 24000000 / (16 × 115200) = 13
  * ====================================================================== */
 static void rk3588_uart_init(void)
 {
     /* 16550 register offsets (32-bit stride on RK3588) */
     mmio_write32(RK3588_UART2_BASE + 0x04u, 0x00u);  /* IER: off          */
     mmio_write32(RK3588_UART2_BASE + 0x0Cu, 0x80u);  /* LCR: DLAB on      */
     mmio_write32(RK3588_UART2_BASE + 0x00u, 0x0Du);  /* DLL: 13 (115200)  */
     mmio_write32(RK3588_UART2_BASE + 0x04u, 0x00u);  /* DLH: 0            */
     mmio_write32(RK3588_UART2_BASE + 0x0Cu, 0x03u);  /* LCR: 8N1, DLAB off*/
     mmio_write32(RK3588_UART2_BASE + 0x08u, 0xC7u);  /* FCR: FIFO enable  */
     mmio_write32(RK3588_UART2_BASE + 0x04u, 0x01u);  /* IER: RX int       */
 
     printf("[soc/rk3588] UART2 @ 0x%08lx  115200 8N1\n",
            (unsigned long)RK3588_UART2_BASE);
 }
 
 /* =========================================================================
  * uiox_soc_init_rk3588
  * ====================================================================== */
 int uiox_soc_init_rk3588(uiox_soc_desc_t *desc)
 {
     if (!desc) return UIOX_SOC_ERR_INVAL;
 
     printf("[soc/rk3588] Initialising Rockchip RK3588 SoC layer...\n");
 
     strncpy(desc->name, "Rockchip RK3588 (A76×4 + A55×4)",
             UIOX_SOC_NAME_LEN - 1);
     desc->soc_id       = UIOX_SOC_RK3588;
     desc->num_cpus     = 8u;
     desc->num_clusters = 2u;   /* big + LITTLE */
     desc->cpu_freq_khz = 2400000u;   /* A76 cluster max */
     desc->l1_icache_kb = 64u;        /* A76 L1-I */
     desc->l1_dcache_kb = 64u;        /* A76 L1-D */
     desc->l2_cache_kb  = 512u;       /* per A76 cluster */
     desc->l3_cache_kb  = 3072u;      /* 3 MB shared L3 */
     desc->dram_base    = 0x00200000UL;
     desc->dram_size    = 0x100000000UL;  /* up to 32 GB LPDDR5 */
     desc->capabilities = UIOX_SOC_CAP_MMU      | UIOX_SOC_CAP_CACHE_L1
                        | UIOX_SOC_CAP_CACHE_L2 | UIOX_SOC_CAP_CACHE_L3
                        | UIOX_SOC_CAP_SMP      | UIOX_SOC_CAP_GIC_V3
                        | UIOX_SOC_CAP_SMMU     | UIOX_SOC_CAP_TRNG
                        | UIOX_SOC_CAP_TRUSTZONE | UIOX_SOC_CAP_SECURE_BOOT
                        | UIOX_SOC_CAP_PCIE      | UIOX_SOC_CAP_USB
                        | UIOX_SOC_CAP_EMMC      | UIOX_SOC_CAP_ETH
                        | UIOX_SOC_CAP_UART      | UIOX_SOC_CAP_PSCI
                        | UIOX_SOC_CAP_DTB;
 
     printf("[soc/rk3588] SoC: %s  CPUs=%u  DRAM=%llu MB\n",
            desc->name, desc->num_cpus,
            (unsigned long long)(desc->dram_size >> 20));
 
     rk3588_cru_init();
 
     uiox_clk_ctx_t *clk = uiox_soc_get_clk();
     uiox_soc_clk_init(clk, desc);
 
     rk3588_gic_init();
     rk3588_uart_init();
 
     uiox_pm_ctx_t *pm = uiox_soc_get_pm();
     uiox_soc_pm_init(pm, desc);
 
     desc->initialized = true;
     printf("[soc/rk3588] Rockchip RK3588 SoC layer ready.\n");
     return UIOX_SOC_OK;
 }
 